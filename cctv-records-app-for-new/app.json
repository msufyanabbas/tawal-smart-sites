{
  "expo": {
    "name": "Smart Tawal",
    "slug": "cctv-records-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/main.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/main.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b03fc"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.msufyanabbas.cctvrecordsapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/main.png",
        "backgroundColor": "#0b03fc"
      },
      "package": "com.msufyanabbas.cctvrecordsapp",
      "versionCode": 21
    },
    "web": {
      "favicon": "./assets/main.png"
    },
    "extra": {
      "eas": {
        "projectId": "ba863d17-b1f5-42b4-8a9c-cb81968fccff"
      },
      "apiUrl": "http://localhost:3000"
    },
    "owner": "usman02s-team",
    "plugins": [
      [
        "expo-mlkit-ocr",
        {
          "iosEngine": "auto"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bd36d27e-09ae-4eb7-8fc2-cb1f9cac1743"
    }
  }
}
